generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH

  @@map("request_priority")
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("request_status")
}

model Technician {
  id        Int              @id @default(autoincrement())
  fullName  String           @map("full_name") @db.VarChar(120)
  email     String           @unique @db.VarChar(150)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  requests  ServiceRequest[]

  @@map("technician")
}

model ServiceType {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  requests    ServiceRequest[]

  @@map("service_type")
}

model ServiceRequest {
  id             Int             @id @default(autoincrement())
  title          String          @db.VarChar(150)
  description    String
  requesterName  String          @map("requester_name") @db.VarChar(120)
  requesterEmail String          @map("requester_email") @db.VarChar(150)
  priority       RequestPriority @default(MEDIUM)
  status         RequestStatus   @default(PENDING)
  technicianId   Int?            @map("technician_id")
  serviceTypeId  Int             @map("service_type_id")
  technician     Technician?     @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  serviceType    ServiceType     @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([technicianId])
  @@index([serviceTypeId])
  @@index([status])
  @@map("service_request")
}
